# === Banco de dados ===
# Local (Docker): postgresql://fisiocase:fisiocase123@localhost:5432/fisiocase?schema=public
# Produção (Railway/Neon): copie a string fornecida pelo provedor.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/DB?schema=public"

# === Autenticação ===
# Gere com: openssl rand -base64 32
JWT_SECRET="troque-este-segredo-por-uma-string-aleatoria-longa"

# === IA Anthropic ===
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx"
# Modelo: claude-sonnet-4-20250514 (qualidade) ou um Haiku para gastar menos
ANTHROPIC_MODEL="claude-sonnet-4-20250514"

# === NextAuth (mesma chave do frontend) ===
NEXTAUTH_SECRET="troque-este-segredo-tambem"
NEXTAUTH_URL="http://localhost:3000"

# === Server ===
PORT=3001

# === CORS ===
# Origens permitidas, separadas por vírgula.
# Em desenvolvimento, deixe vazio (libera tudo).
# Em produção: https://seu-frontend.vercel.app
ALLOWED_ORIGINS=
