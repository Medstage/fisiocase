# URL pública do backend (Vercel/Railway/etc).
# Em desenvolvimento local: http://localhost:3001
NEXT_PUBLIC_API_URL=https://seu-backend.up.railway.app

# NextAuth — gere com: openssl rand -base64 32
NEXTAUTH_SECRET=troque-este-segredo-em-producao

# URL pública do FRONT (Vercel injeta automaticamente em produção via VERCEL_URL,
# mas em dev/local use a explícita).
NEXTAUTH_URL=http://localhost:3000
